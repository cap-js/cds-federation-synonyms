# CF domain suffix
domain=

# mtx sidecar hostname (without domain)
mtx_host=

# subscribed tenant AppRouter hostname — pattern: <tenant-subdomain>-<app-name> (without domain)
tenant_host=

# subdomain/ID of the tenant to use in requests
tenant_id=

# user token (password grant, tenant-specific)
token=

# service token (client credentials, operator subaccount)
mtx_token=
