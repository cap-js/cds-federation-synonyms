{
  "name": "xtravels-mtx",
  "engines": {
    "node": "^24.22.1"
  },
  "dependencies": {
    "@cap-js/audit-logging": "^1.3.0",
    "@cap-js/cds-federation-synonyms": "file:../../../cap-js-cds-federation-synonyms-0.0.1.tgz",
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-mtxs": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "profile": "mtx-sidecar",
    "requires": {
      "db": {
        "kind": "hana",
        "vcap": {
          "name": "xtravels-db"
        }
      },
      "xflights-db": {
        "kind": "hana",
        "vcap": {
          "name": "xflights-db"
        },
        "synonyms": {
          "connect_mode": "dynamic"
        }
      },
      "audit-log": {
        "kind": "audit-log-to-console",
        "subscriptionDependency": false
      }
    }
  }
}
