{
  "name": "@capire/xtravels",
  "version": "1.0.1",
  "description": "CAP sample for travels app",
  "scripts": {
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js/cds-federation-synonyms": "file:../cap-js-cds-federation-synonyms-0.0.1.tgz",
    "@cap-js/hana": "^3",
    "@capire/xflights-data-syn": "file:../apis/capire-xflights-data-syn-0.1.3.tgz",
    "@sap/cds": "^10",
    "@sap/cds-mtxs": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "sap.capire.flights.FlightsService_syn": {
        "synonyms": {
          "service-manager": "xflights-db"
        }
      }
    },
    "profile": "with-mtx-sidecar"
  },
  "license": "Apache-2.0"
}
