{
  "name": "@cap-js/cds-federation-synonyms",
  "version": "0.0.1",
  "description": "CDS plugin for data federation via synonyms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/cds-federation-synonyms.git"
  },
  "license": "Apache-2.0",
  "author": "SAP SE (https://www.sap.com)",
  "homepage": "https://cap.cloud.sap/",
  "main": "cds-plugin.js",
  "scripts": {
    "lint": "npx eslint .",
    "test": "npx jest --silent"
  },
  "files": [
    "doc",
    "lib",
    "cds-plugin.js"
  ],
  "workspaces": [
    "test"
  ],
  "devDependencies": {
    "@cap-js/cds-federation-synonyms": "file:.",
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds-dk": ">=9.9.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=9.6.1"
  },
  "cds": {
    "requires": {
      "[mtx-sidecar]": {
        "mtx-model": true
      },
      "[with-mtx-sidecar]": {
        "app-model": true
      },
      "kinds": {
        "mtx-model": {
          "model": "@cap-js/cds-federation-synonyms/lib/mtx-service.cds",
          "impl": "@cap-js/cds-federation-synonyms/lib/mtx-service.js"
        },
        "app-model": {
          "model": "@cap-js/cds-federation-synonyms/lib/app-service.cds",
          "impl": "@cap-js/cds-federation-synonyms/lib/app-service.js"
        }
      }
    }
  }
}
